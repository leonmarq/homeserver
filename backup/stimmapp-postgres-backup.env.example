# Install as /etc/stimmapp-postgres-backup.env, owned by root with mode 0600.
POSTGRES_CONTAINER=stimmapp-dev-postgres
POSTGRES_DATABASE=stimmapp_pid_verifier
POSTGRES_USER=stimmapp_pid_verifier
BACKUP_STAGING_DIR=/var/lib/stimmapp-postgres-backup
RESTIC_KEEP_DAILY=30
RESTIC_COMMAND=/opt/homeserver/.local/restic/usr/bin/restic

# restic encrypts every repository. Store this password outside this repository.
RESTIC_PASSWORD_FILE=/etc/stimmapp-postgres-restic-password

# Choose exactly one backend and remove the unused examples.
# S3-compatible:
RESTIC_REPOSITORY=s3:https://s3.example.invalid/stimmapp-postgres
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me

# SFTP/Storage Box alternative (SSH host key must already be trusted by root):
# RESTIC_REPOSITORY=sftp:backup-user@storage.example.invalid:/backups/stimmapp-postgres
